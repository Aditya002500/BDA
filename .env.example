# Neo4j Aura Graph Database Connection
# Replace with your credentials from Neo4j Aura Console (https://console.neo4j.io)
NEO4J_URI=neo4j+s://6c9873be.databases.neo4j.io
NEO4J_USERNAME=6c9873be
NEO4J_PASSWORD=your_neo4j_password_here
NEO4J_DATABASE=neo4j

# Optional: Legacy Redis Cloud configuration
REDIS_URL=redis://default:your_redis_password@your_redis_host:port